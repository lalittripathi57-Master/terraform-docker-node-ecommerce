#!/bin/bash
set -euxo pipefail

exec > >(tee /var/log/ecommerce-user-data.log | logger -t user-data -s 2>/dev/console) 2>&1

# Update OS and install required packages
apt-get update -y
DEBIAN_FRONTEND=noninteractive apt-get install -y docker.io git curl

# Enable and start Docker
systemctl enable --now docker

# Clone GitHub repository
cd /opt
rm -rf terraform-docker-node-ecommerce

git clone https://github.com/lalittripathi57-Master/terraform-docker-node-ecommerce.git

cd terraform-docker-node-ecommerce

# Build Docker images directly on EC2
docker build -t user-service:latest ./user-service
docker build -t products-service:latest ./products-service
docker build -t orders-service:latest ./orders-service
docker build -t cart-service:latest ./cart-service
docker build -t ecommerce-frontend:latest ./frontend

# Create Docker network
docker network create ecommerce-net || true

# Remove containers if they already exist
for c in user-service products-service orders-service cart-service ecommerce-frontend; do
  docker rm -f "$c" 2>/dev/null || true
done

# Start backend services
docker run -d \
  --restart unless-stopped \
  --name user-service \
  --network ecommerce-net \
  -p 127.0.0.1:3001:3001 \
  user-service:latest

docker run -d \
  --restart unless-stopped \
  --name products-service \
  --network ecommerce-net \
  -p 127.0.0.1:3002:3002 \
  products-service:latest

docker run -d \
  --restart unless-stopped \
  --name orders-service \
  --network ecommerce-net \
  -p 127.0.0.1:3003:3003 \
  orders-service:latest

docker run -d \
  --restart unless-stopped \
  --name cart-service \
  --network ecommerce-net \
  -p 127.0.0.1:3004:3004 \
  cart-service:latest

# Start frontend
docker run -d \
  --restart unless-stopped \
  --name ecommerce-frontend \
  --network ecommerce-net \
  -p 3000:3000 \
  -e USER_SERVICE_URL=http://user-service:3001 \
  -e PRODUCTS_SERVICE_URL=http://products-service:3002 \
  -e ORDERS_SERVICE_URL=http://orders-service:3003 \
  -e CART_SERVICE_URL=http://cart-service:3004 \
  ecommerce-frontend:latest

docker ps